{
  "name": "imperial-crown-3d",
  "private": true,
  "version": "2.0.0",
  "description": "Imperial Crown 3D \u2014 a hand-built, mobile-first real-time strategy engine for Android (Realme 9i tuned).",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node tests/run.mjs",
    "test:ci": "node tests/run.mjs --ci",
    "test:sim": "node tests/sim.test.mjs",
    "test:combat": "node tests/combat.test.mjs",
    "test:render": "node tests/render.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "test:app": "node tests/app.test.mjs",
    "test:dist": "node tests/dist.test.mjs",
    "balance": "node tests/balance.test.mjs --full",
    "apk": "bash scripts/build-apk.sh",
    "test:browser": "eval \"$(node scripts/browser-libs.mjs --export)\" && node tests/browser.mjs --seconds 8 --dpr 1.5",
    "test:geo": "node tests/geo.test.mjs",
    "test:audio": "node tests/audio.test.mjs",
    "test:shaders": "node tests/shaders.test.mjs",
    "test:contract": "node tests/contract.test.mjs",
    "test:perf": "node tests/perf.test.mjs",
    "test:ai": "node tests/ai.test.mjs 900",
    "shot": "node tests/shot.mjs",
    "test:daynight": "node tests/daynight.test.mjs",
    "test:soak": "eval \"$(node scripts/browser-libs.mjs --export)\" && node tests/soak.mjs --seconds 40 --units 260",
    "browser:deps": "node scripts/browser-libs.mjs --export",
    "test:play": "eval \"$(node scripts/browser-libs.mjs --export)\" && node tests/playtest.mjs"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@sparticuz/chromium": "^131.0.1",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^23.11.1",
    "vite": "^7.1.0"
  }
}
